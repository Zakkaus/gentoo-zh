Point the CEF external dependency at the prebuilt binary distribution
unpacked into vendor/cef instead of downloading it during the build.

Gentoo packaging only, not suitable for upstream.

--- a/lito.toml
+++ b/lito.toml
@@ -131,17 +131,10 @@
 
 [workspace.external-dependencies.cmake.cef]
 find-package = "CEF"
+path = "vendor/cef"
 integration = "build-tree"
 add-subdirectory = false
 adapter = "src/Web/cmake/CEF.cmake"
 
-[workspace.external-dependencies.cmake.cef.archives.x86_64]
-archive = "https://cef-builds.spotifycdn.com/cef_binary_149.0.4%2Bg2f1bfd8%2Bchromium-149.0.7827.156_linux64_minimal.tar.bz2"
-sha256 = "6d43607675e47ed6bfa40d1cfce136d04e7720529f8f1c4435d4ba1dcd1839b2"
-
-[workspace.external-dependencies.cmake.cef.archives.aarch64]
-archive = "https://cef-builds.spotifycdn.com/cef_binary_149.0.4%2Bg2f1bfd8%2Bchromium-149.0.7827.156_linuxarm64_minimal.tar.bz2"
-sha256 = "8909a79689eec7b23ed80084b69766952d44e00f9a345832951b32903f8a80a0"
-
 [workspace.external-dependencies.cmake.waywallen-bridge]
 find-package = "waywallen-bridge"
